<UserControl x:Class="Ludo.Presentation.Wpf.Views.NotificationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ludo.Presentation.Wpf.Views">
    <!-- Notifications with answer buttons: the composer, then the ones sent and received. -->
    <StackPanel>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="New" Padding="12,4" FontSize="12"
                    VerticalAlignment="Center" Command="{Binding ComposeCommand}" />
            <TextBlock Text="Group Decisions" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="{StaticResource Accent}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Margin="8,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Visibility>
                    <Binding Path="PendingCount" Converter="{x:Static views:CountToVisibilityConverter.Instance}" />
                </Border.Visibility>
                <TextBlock Text="{Binding PendingCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DockPanel>
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,14" TextWrapping="Wrap"
                   Text="Ask the people you pick. Everyone asked sees every vote." />

        <!-- Writing a new one. -->
        <Border CornerRadius="14" Padding="16" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Accent}"
                BorderThickness="1" Margin="0,0,0,14" views:Motion.Enter="True"
                Visibility="{Binding IsComposing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Overline}" Text="QUESTION" />
                <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxQuestionLength, Mode=OneTime}"
                         Tag="What should we decide?" TextWrapping="Wrap" FontSize="13" />

                <TextBlock Style="{StaticResource Overline}" Text="ANSWERS" />
                <ItemsControl ItemsSource="{Binding OptionFields}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="4,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="Remove answer">
                                    <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource CloseIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength, Mode=OneTime}"
                                         Tag="Answer text" Margin="0" FontSize="13" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource SecondaryButton}" Content="Add an answer" Padding="10,4" FontSize="12" HorizontalAlignment="Left"
                        Margin="0,0,0,12" Command="{Binding AddOptionCommand}" />

                <TextBlock Style="{StaticResource Overline}" Text="SEND TO" />
                <ItemsControl ItemsSource="{Binding Choices}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsChecked}" Margin="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <views:AvatarView Person="{Binding Person}" Size="28" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Person.Name}" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel Margin="-4,10,0,0">
                    <Button Margin="4" Padding="14,7" Content="Send" Command="{Binding SendCommand}" />
                    <Button Margin="4" Padding="14,7" Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Sent and received, newest first. -->
        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="14" Padding="14" Margin="0,0,0,10" BorderThickness="1" views:Motion.Enter="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsAnswer}" Value="True">
                                        <Setter Property="Background" Value="#2A2619" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Margin="4,0,0,0"
                                        Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="Clear group decision">
                                    <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource CloseIcon}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <views:AvatarView DockPanel.Dock="Left" Person="{Binding Sender}" Size="28" Margin="0,0,8,0" VerticalAlignment="Top" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding Recipients}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="{Binding Question}" TextWrapping="Wrap" Margin="0,10,0,8" />

                            <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="13" FontWeight="SemiBold" Margin="10,0,2,0"
                                                           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                                <Grid>
                                                    <!-- The chosen answer stands out. Clicking another one changes it. -->
                                                    <Button Padding="12,5" FontSize="13" Content="{Binding Label}" HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.VoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Index}"
                                                            Visibility="{Binding ShowChosen, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="13" Content="{Binding Label}" HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.VoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Index}"
                                                            Visibility="{Binding ShowVote, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding Voters}" TextWrapping="Wrap" Margin="2,2,0,0"
                                                       Visibility="{Binding HasVoters, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding Waiting}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding HasWaiting, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
