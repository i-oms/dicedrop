<security:ProtectedWindow x:Class="Ludo.Presentation.Wpf.Views.PollAlertWindow"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:security="clr-namespace:Ludo.Presentation.Wpf.Security"
                          xmlns:views="clr-namespace:Ludo.Presentation.Wpf.Views"
                          Title="DiceDrop group decision"
                          WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
                          ShowActivated="False" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
                          Background="#2A2619" BorderBrush="{StaticResource Accent}" BorderThickness="2">
    <StackPanel x:Name="Body" Width="420">
        <!-- A solid banner, so it cannot be mistaken for a chat pop-up. -->
        <Border Background="{StaticResource Accent}" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource NudgeIcon}" Fill="{StaticResource AccentText}"
                      Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="DiceDrop · group decision · your vote is needed" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentText}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Clicking the card opens the lobby; the buttons answer right here. -->
                        <Border Padding="16,14" Background="Transparent" Cursor="Hand" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                                MouseLeftButtonUp="OnCardClicked" views:Motion.Enter="True" views:Motion.EnterOffset="8">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Margin="4,0,0,0"
                                            Click="OnDismissClicked" AutomationProperties.Name="Dismiss">
                                        <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource CloseIcon}"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <views:AvatarView DockPanel.Dock="Left" Person="{Binding Sender}" Size="32" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Question}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,12" />
                                <ItemsControl ItemsSource="{Binding Options}" Margin="-4,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="4" Padding="16,8" MinWidth="96" Content="{Binding Label}"
                                                    Command="{Binding DataContext.VoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Index}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</security:ProtectedWindow>
