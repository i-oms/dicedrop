<UserControl x:Class="Ludo.Presentation.Wpf.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:board="clr-namespace:Ludo.Presentation.Wpf.Views.Board"
             xmlns:views="clr-namespace:Ludo.Presentation.Wpf.Views">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <board:BoardCanvas Game="{Binding Game}" MoveCommand="{Binding MoveCommand}" Margin="8" />

        <DockPanel Grid.Column="1">
            <!-- Turn and dice. The card's top edge takes the colour of whoever's turn it is. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="0" views:Motion.Enter="True">
                <StackPanel>
                    <Border Height="4" CornerRadius="13,13,0,0" Background="{Binding TurnColor}" />
                    <StackPanel Margin="18,12,18,14">
                        <TextBlock Style="{StaticResource Overline}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <board:DiceView Height="104" Margin="0,4,0,2"
                                        Value="{Binding DiceValue}" RollCount="{Binding RollCount}"
                                        IsRolling="{Binding IsRolling}" IsReady="{Binding CanRoll}"
                                        Tint="{Binding TurnColor}" Command="{Binding RollCommand}" />
                        <Border HorizontalAlignment="Center" CornerRadius="10" Padding="10,3" Background="{StaticResource AccentSoft}"
                                Visibility="{Binding CanRoll, Converter={StaticResource BoolToVisibility}}" views:Motion.Pulse="True">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="Your roll · click the dice or press Space" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10" views:Motion.Enter="True">
                <ItemsControl ItemsSource="{Binding Seats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="8" Padding="0,5,10,5" Margin="0,1" Background="Transparent">
                                <DockPanel>
                                    <Border x:Name="Marker" DockPanel.Dock="Left" Width="3" CornerRadius="2" Margin="2,0,8,0"
                                            Background="{Binding Color}" Opacity="0" />
                                    <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0">
                                        <Ellipse Fill="{Binding Color}" />
                                        <Ellipse Margin="4,3,6,7" Fill="White" Opacity="0.35" />
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" Text="{Binding Detail}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="SeatName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceRaised}" />
                                    <Setter TargetName="Marker" Property="Opacity" Value="1" />
                                    <Setter TargetName="SeatName" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasLeft}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Who else has this board open. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" views:Motion.Enter="True"
                    Visibility="{Binding HasWatchers, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Overline}" Text="{Binding WatchersTitle}" />
                    <ItemsControl ItemsSource="{Binding Watchers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,6,14,0">
                                    <views:AvatarView Person="{Binding Person}" Size="20" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" Background="#2A2619"
                    Visibility="{Binding IsOver, Converter={StaticResource BoolToVisibility}}" views:Motion.Enter="True"
                    views:Motion.EnterOffset="-14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Overline}" Foreground="{StaticResource Accent}" Text="GAME OVER" />
                    <TextBlock Style="{StaticResource Heading}" Text="{Binding Outcome}" TextWrapping="Wrap" Margin="0,2,0,6" />
                    <TextBlock Text="{Binding Ranking}" FontSize="15" LineHeight="22" />
                </StackPanel>
            </Border>

            <WrapPanel DockPanel.Dock="Bottom" Margin="4,4,4,0" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Leave game" Margin="4"
                        Command="{Binding LeaveCommand}"
                        Visibility="{Binding CanLeave, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Stop game" Margin="4"
                        Command="{Binding StopCommand}"
                        Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Back to lobby" Margin="4" Command="{Binding BackCommand}" />
            </WrapPanel>

            <!-- The game's own group chat, for its players and watchers; the latest moves sit above it. -->
            <Border Style="{StaticResource Card}" Padding="14" views:Motion.Enter="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" CornerRadius="10" Padding="10,6" Background="{StaticResource SurfaceSunken}">
                        <ItemsControl ItemsSource="{Binding Log}" MaxHeight="36" ClipToBounds="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <Ellipse DockPanel.Dock="Left" Width="4" Height="4" Fill="{StaticResource TextFaint}" Margin="0,0,8,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <views:ChatPanel DataContext="{Binding Chat}" />
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
