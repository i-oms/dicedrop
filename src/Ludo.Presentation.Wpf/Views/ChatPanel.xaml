<UserControl x:Class="Ludo.Presentation.Wpf.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ludo.Presentation.Wpf.Views">
    <!-- One conversation as message bubbles. DataContext is a ConversationViewModel. -->
    <UserControl.Resources>
        <!-- Other people: avatar and name on the first line of a run, bubbles on the left. -->
        <DataTemplate x:Key="OtherMessage">
            <Grid views:Motion.Enter="True" views:Motion.EnterOffset="8" Margin="0,2,56,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StartsGroup}" Value="True">
                                <Setter Property="Margin" Value="0,14,56,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <views:AvatarView Person="{Binding Sender}" Size="34" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0"
                                  Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Column="1">
                    <TextBlock Margin="2,0,0,4" Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="{Binding Sender.Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                        <Run Text="  " FontSize="11" />
                        <Run Text="{Binding TimeLabel, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextFaint}" />
                    </TextBlock>
                    <Border HorizontalAlignment="Left" Background="{StaticResource SurfaceRaised}" Padding="13,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StartsGroup}" Value="True">
                                        <Setter Property="CornerRadius" Value="4,16,16,16" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Our own lines: accent bubbles on the right. -->
        <DataTemplate x:Key="LocalMessage">
            <StackPanel views:Motion.Enter="True" views:Motion.EnterOffset="8" Margin="80,2,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StartsGroup}" Value="True">
                                <Setter Property="Margin" Value="80,14,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock HorizontalAlignment="Right" Margin="0,0,2,4" FontSize="11" Foreground="{StaticResource TextFaint}"
                           Text="{Binding TimeLabel}"
                           Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisibility}}" />
                <Border HorizontalAlignment="Right" Background="{StaticResource Accent}" Padding="13,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="16" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StartsGroup}" Value="True">
                                    <Setter Property="CornerRadius" Value="16,4,16,16" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource AccentText}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Nudges: a small centred event line. -->
        <DataTemplate x:Key="NudgeMessage">
            <Border HorizontalAlignment="Center" Margin="0,16,0,2" Padding="12,5" CornerRadius="14" Background="{StaticResource AccentSoft}"
                    views:Motion.Enter="True" views:Motion.EnterOffset="-6">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"
                          Data="{StaticResource NudgeIcon}" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center">
                        <Run Text="{Binding Text, Mode=OneWay}" />
                        <Run Text="{Binding TimeLabel, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource TextMuted}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <views:ChatTemplateSelector x:Key="MessageTemplates"
                                    LocalTemplate="{StaticResource LocalMessage}"
                                    OtherTemplate="{StaticResource OtherMessage}"
                                    NudgeTemplate="{StaticResource NudgeMessage}" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Composer: placeholder, a character count near the limit, and a round send button. Enter sends. -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="4" CornerRadius="24" Background="{StaticResource SurfaceRaised}"
                BorderBrush="{StaticResource Border}" BorderThickness="1" IsEnabled="{Binding CanWrite}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding SendCommand}"
                        AutomationProperties.Name="Send message">
                    <Path Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z" />
                </Button>
                <TextBlock x:Name="Counter" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,8,0" FontSize="11"
                           Foreground="{StaticResource TextFaint}" Visibility="Collapsed" />
                <TextBox x:Name="Composer" Margin="0" BorderThickness="0" Background="Transparent" Padding="14,0"
                         VerticalContentAlignment="Center" Tag="{Binding Placeholder}"
                         MaxLength="{Binding MaxChatLength, Mode=OneTime}"
                         Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="OnComposerTextChanged">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- The other person left: their history stays, but there is no one to write to. -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12,8" CornerRadius="10" Background="{StaticResource SurfaceRaised}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanWrite}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center">
                <Run Text="{Binding Person.Name, Mode=OneWay}" /><Run Text=" left the lobby." />
            </TextBlock>
        </Border>

        <Grid>
            <!-- Empty state. -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" views:Motion.Enter="True">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid HorizontalAlignment="Center">
                    <views:AvatarView Person="{Binding Person}" Size="64"
                                      Visibility="{Binding IsLobby, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Grid Width="64" Height="64" Visibility="{Binding IsLobby, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Fill="{StaticResource AccentSoft}" />
                        <Path Width="28" Height="28" Stretch="Uniform" Fill="{StaticResource Accent}" Data="{StaticResource ChatIcon}" />
                    </Grid>
                </Grid>
                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="15" Margin="0,14,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Text" Value="{Binding Person.Name, StringFormat='This is the start of your chat with {0}'}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLobby}" Value="True">
                                    <Setter Property="Text" Value="No messages yet" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="300" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="Text" Value="Only the two of you can see these messages. Nothing is saved." />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLobby}" Value="True">
                                    <Setter Property="Text" Value="Everyone in the lobby sees this chat. Nothing is saved." />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGameChat}" Value="True">
                                    <Setter Property="Text" Value="For this game's players and watchers. Nothing is saved." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ScrollChanged="OnScrollChanged" Padding="0,0,6,6">
                <ItemsControl ItemsSource="{Binding Messages}" ItemTemplateSelector="{StaticResource MessageTemplates}" />
            </ScrollViewer>

            <!-- Shown when lines arrive while scrolled up to read older ones. -->
            <Button x:Name="NewMessages" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                    Padding="14,6" FontSize="12" Visibility="Collapsed" views:Motion.Enter="True" views:Motion.EnterOffset="12"
                    Click="OnNewMessagesClick">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.5" Color="Black" />
                </Button.Effect>
                <TextBlock Foreground="{StaticResource AccentText}" FontSize="12" FontWeight="SemiBold" Text="New messages  ↓" />
            </Button>
        </Grid>
    </DockPanel>
</UserControl>
