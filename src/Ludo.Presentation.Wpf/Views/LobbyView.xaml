<UserControl x:Class="Ludo.Presentation.Wpf.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ludo.Presentation.Wpf.Views">
    <!-- The main screen: conversations on the left, the open chat in the middle, notifications and games on the right. -->
    <UserControl.Resources>
        <Style x:Key="PaneTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Unread count bubble. -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A row in the conversation list. Its DataContext is a ConversationViewModel. -->
        <Style x:Key="ConversationRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome" CornerRadius="12" Background="Transparent" Padding="10,8">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Marker" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,12" Background="{StaticResource Accent}"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceRaised}" />
                                <Setter TargetName="Marker" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="304" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: me, then the conversations ===== -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14,12,48">
                <!-- Me, with settings. -->
                <DockPanel DockPanel.Dock="Top" Margin="6,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                            Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            AutomationProperties.Name="Settings">
                        <Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource GearIcon}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <views:AvatarView DockPanel.Dock="Left" Person="{Binding Me}" Size="40" ShowPresence="True" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Me.Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Overline}" Text="CHATS" Margin="10,0,0,6" />

                <!-- Virtualized: only rows on screen exist, so only their avatar photos get fetched. -->
                <ItemsControl ItemsSource="{Binding Conversations}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ConversationRow}" Margin="0,1"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Left" Margin="0,0,12,0">
                                            <views:AvatarView Person="{Binding Person}" Size="40" ShowPresence="True"
                                                              Visibility="{Binding IsLobby, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Grid Width="40" Height="40" Visibility="{Binding IsLobby, Converter={StaticResource BoolToVisibility}}">
                                                <Ellipse Fill="{StaticResource AccentSoft}" />
                                                <Path Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource Accent}" Data="{StaticResource GroupIcon}" />
                                            </Grid>
                                        </Grid>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="8,0,0,0" views:Motion.Enter="True"
                                                views:Motion.EnterOffset="0">
                                            <Border.Visibility>
                                                <Binding Path="Unread" Converter="{x:Static views:CountToVisibilityConverter.Instance}" />
                                            </Border.Visibility>
                                            <TextBlock Text="{Binding Unread}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Text" Value="{Binding Person.Name}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLobby}" Value="True">
                                                                <Setter Property="Text" Value="Lobby" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                        <Setter Property="Text" Value="{Binding Preview}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Preview}" Value="">
                                                                <Setter Property="Text" Value="{Binding Person.Status, FallbackValue='Everyone in the lobby'}" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Preview}" Value="" />
                                                                    <Condition Binding="{Binding IsLobby}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Text" Value="Everyone in the lobby" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ===== Middle: the open conversation ===== -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Height="68" Padding="22,0,14,0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <DockPanel DataContext="{Binding SelectedConversation}">
                    <!-- Private conversations: nudge, or invite this person to a game. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsLobby, Converter={StaticResource InverseBoolToVisibility}}">
                        <Button Style="{StaticResource GhostButton}" Padding="10,7" Command="{Binding NudgeCommand}" AutomationProperties.Name="Nudge">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource NudgeIcon}" Margin="0,0,7,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Nudge" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="10,7" Margin="4,0,0,0"
                                Command="{Binding DataContext.InvitePersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Key}" AutomationProperties.Name="Invite to a game">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource GameIcon}" Margin="0,0,7,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Invite to Ludo" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center">
                        <views:AvatarView Person="{Binding Person}" Size="38" ShowPresence="True"
                                          Visibility="{Binding IsLobby, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Grid Width="38" Height="38" Visibility="{Binding IsLobby, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Fill="{StaticResource AccentSoft}" />
                            <Path Width="19" Height="19" Stretch="Uniform" Fill="{StaticResource Accent}" Data="{StaticResource GroupIcon}" />
                        </Grid>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PaneTitle}">
                                    <Setter Property="Text" Value="{Binding Person.Name}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLobby}" Value="True">
                                            <Setter Property="Text" Value="Lobby" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Text" Value="{Binding Person.Status}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLobby}" Value="True">
                                            <Setter Property="Text" Value="{Binding DataContext.Status, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <views:ChatPanel DataContext="{Binding SelectedConversation}" FocusOnOpen="True" Margin="22,4,22,18" />
        </DockPanel>

        <!-- ===== Right: games ===== -->
        <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,20,18,48">
                    <views:NotificationsPanel DataContext="{Binding Notifications}" Margin="0,0,0,10" />

                    <TextBlock Style="{StaticResource PaneTitle}" Text="Games" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,14" TextWrapping="Wrap"
                               Text="Invite anyone who is free. Several games can run at once, and anyone can watch." />

                    <!-- The open invites and running games. -->
                    <ItemsControl ItemsSource="{Binding MatchCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14"
                                      views:Motion.Enter="True">
                                    <Border CornerRadius="14" BorderBrush="{StaticResource Accent}" BorderThickness="2"
                                            Visibility="{Binding IsInvitedNow, Converter={StaticResource BoolToVisibility}}" views:Motion.Pulse="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.8" Color="{StaticResource AccentColor}" />
                                        </Border.Effect>
                                    </Border>
                                    <Border CornerRadius="14" Padding="16" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInvitedNow}" Value="True">
                                                        <Setter Property="Background" Value="#2A2619" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding GameTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding GameDetail}" TextWrapping="Wrap" Margin="0,3,0,0" />

                                            <ItemsControl ItemsSource="{Binding Invitees}" Margin="0,12,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3">
                                                            <views:AvatarView DockPanel.Dock="Left" Person="{Binding Person}" Size="24" Margin="0,0,8,0" />
                                                            <TextBlock x:Name="Answer" DockPanel.Dock="Right" Text="{Binding Answer}" FontSize="12" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                                            <TextBlock Text="{Binding Person.Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsIn}" Value="True">
                                                                <Setter TargetName="Answer" Property="Foreground" Value="{StaticResource Success}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <WrapPanel Margin="-4,8,0,0">
                                                <Button Margin="4" Padding="14,7" Content="{Binding BeginLabel}" Command="{Binding BeginCommand}"
                                                        Visibility="{Binding ShowBegin, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Margin="4" Padding="14,7" Content="Join game" Command="{Binding AcceptCommand}"
                                                        Visibility="{Binding ShowAccept, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Margin="4" Padding="14,7" Style="{StaticResource SecondaryButton}" Content="Not now" Command="{Binding DeclineCommand}"
                                                        Visibility="{Binding IsInvitedNow, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Margin="4" Padding="14,7" Style="{StaticResource SecondaryButton}" Content="Back out" Command="{Binding DeclineCommand}"
                                                        Visibility="{Binding ShowDecline, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Margin="4" Padding="14,7" Content="{Binding WatchLabel}" Command="{Binding WatchCommand}"
                                                        Visibility="{Binding ShowWatch, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Margin="4" Padding="14,7" Style="{StaticResource SecondaryButton}" Content="Cancel invite" Command="{Binding StopCommand}"
                                                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Margin="4" Padding="14,7" Style="{StaticResource SecondaryButton}" Content="Stop game" Command="{Binding StopCommand}"
                                                        Visibility="{Binding ShowStop, Converter={StaticResource BoolToVisibility}}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Picking who to invite. -->
                    <Border CornerRadius="14" Padding="16" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Accent}"
                            BorderThickness="1" Margin="0,0,0,14" views:Motion.Enter="True"
                            Visibility="{Binding IsPicking, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding Picking.Name, StringFormat='Invite to {0}'}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,10" Text="Pick who can join. Everyone else can watch." />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Nobody else is free right now." TextWrapping="Wrap">
                                <TextBlock.Visibility>
                                    <Binding Path="InviteChoices.Count" Converter="{x:Static views:CountToVisibilityConverter.Instance}" ConverterParameter="invert" />
                                </TextBlock.Visibility>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding InviteChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsChecked}" Margin="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <views:AvatarView Person="{Binding Person}" Size="28" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Person.Name}" VerticalAlignment="Center" FontSize="13" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="-4,10,0,0">
                                <Button Margin="4" Padding="14,7" Content="Send invite" Command="{Binding SendInviteCommand}" />
                                <Button Margin="4" Padding="14,7" Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelPickCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- The catalog. -->
                    <TextBlock Style="{StaticResource Overline}" Text="AVAILABLE GAMES" Margin="2,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="14" Padding="14" Margin="0,0,0,10" Background="{StaticResource SurfaceRaised}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Margin="0,0,12,0"
                                                    Background="{StaticResource AccentSoft}">
                                                <Path Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource Accent}" Data="{StaticResource GameIcon}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Info.Name}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding Players}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{Binding Info.Description}" TextWrapping="Wrap"
                                                   Margin="0,10,0,12" LineHeight="18" />
                                        <Button Content="Invite players" Padding="14,7" HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.PickPlayersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.CanPropose, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
